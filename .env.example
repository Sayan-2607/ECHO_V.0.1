# ── Required ──────────────────────────────────────────────────────────────
# Key for any OpenAI-compatible chat-completions endpoint.
OPENAI_API_KEY=
# Model id. Must support JSON mode (response_format=json_object) and streaming.
OPENAI_MODEL=gpt-4.1-mini
# Tavily search API key (https://tavily.com). This powers ECHO's ONE external tool: web_search.
TAVILY_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────
# Point at another OpenAI-compatible provider (e.g. OpenRouter, Together, a local vLLM).
OPENAI_BASE_URL=
PORT=3000
DATABASE_PATH=./data/echo.db
# Fallback timezone. The browser's IANA timezone is sent with each message and stored per conversation.
APP_TIMEZONE=Asia/Kolkata
# Maximum web_search calls per user request (hard limit, enforced in code).
MAX_TOOL_CALLS=4
SEARCH_CACHE_TTL_SECONDS=900
SEARCH_TIMEOUT_MS=12000
SEARCH_MAX_RETRIES=2
SEARCH_MAX_RESULTS=5
# Whole-request deadline (understand → deliver).
REQUEST_TIMEOUT_MS=120000
# Approximate token budget for retrieved memory placed in prompts.
MEMORY_TOKEN_BUDGET=3000
LOG_LEVEL=info
